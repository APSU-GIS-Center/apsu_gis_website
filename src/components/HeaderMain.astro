---

import Logo from '../assets/theme-images/logo.svg'
import UnitLogoUrl from '../assets/images/APSU-Logo-GIS-Horizontal.png?url'

const { settings } = Astro.props
const navPrefix = import.meta.env.BASE_URL.replace(/\/$/, '')

---

<header class="wrapper bg-loop font-semibold">
  <div class="bs-container py-6 flex justify-between items-center">
    <a class="flex xl:min-w-32 group items-center" href={import.meta.env.BASE_URL} aria-label={ settings.title + ' - Home' }>
      <img src={UnitLogoUrl} alt={settings.title + ' logo'} class="h-12 object-contain filter brightness-0 invert" />
    </a>

    <nav aria-label="Primary" class="hidden col-span-6 md:flex mx-auto self-stretch lg:gap-2">
      { settings.nav.map((item, itemIndex) =>
        item.submenu ? (
          <div class="relative" data-nav-dropdown>
            <div class="flex items-center">
              <a
                class="bs-btn bs-dropdown-focus !bg-transparent before:translate-y-full hover:before:translate-y-0"
                href={item.link.startsWith('/') ? navPrefix + item.link : item.link}
                data-dropdown-link
              >
                { item.title }
              </a>
              <button
                type="button"
                class="bs-btn bs-dropdown-focus !bg-transparent !px-2 before:translate-y-full hover:before:translate-y-0"
                data-dropdown-trigger
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls={`nav-submenu-${itemIndex}`}
                aria-label={`Toggle ${item.title} menu`}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70 transition-opacity">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </button>
            </div>

            <div
              id={`nav-submenu-${itemIndex}`}
              data-dropdown-menu
              class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible pointer-events-none transition-all duration-200 ease-bs-spring origin-top translate-y-2 z-50"
              role="menu"
              aria-label={`${item.title} submenu`}
            >
              <div class="bg-bs-surface-1 border border-bs-surface-3 rounded-xl p-2 min-w-[260px] max-w-[90vw] shadow-xl flex flex-col gap-1">
                { item.submenu.map((subitem) => (
                  subitem.title === "—" ? (
                    <hr class="border-bs-surface-3 my-1" />
                  ) : subitem.enabled === false ? (
                    <span class="block px-4 py-3 rounded-lg text-sm text-left text-bs-foreground-dark cursor-not-allowed" aria-disabled="true">
                      { subitem.title }
                    </span>
                  ) : (
                    <a
                      class="bs-dropdown-focus block px-4 py-3 hover:bg-bs-surface-3 rounded-lg text-sm text-left text-bs-foreground-light hover:text-white transition-colors"
                      href={subitem.link.startsWith('/') ? navPrefix + subitem.link : subitem.link}
                      role="menuitem"
                    >
                      { subitem.title }
                    </a>
                  )
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a class="bs-btn !bg-transparent before:translate-y-full hover:before:translate-y-0" href={item.link.startsWith('/') ? navPrefix + item.link : item.link}>
            { item.title }
          </a>
        )
      )}
    </nav>

    <a href={navPrefix + "/contact"} class="min-w-32 bs-btn">
      { settings.demo.title }
    </a>
  </div>
</header>

<script>
  const supportsFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  const dropdowns = Array.from(document.querySelectorAll('[data-nav-dropdown]'));

  dropdowns.forEach((dropdown) => {
    const trigger = dropdown.querySelector('[data-dropdown-trigger]');
    const navLink = dropdown.querySelector('[data-dropdown-link]');
    const menu = dropdown.querySelector('[data-dropdown-menu]');
    if (!trigger || !menu || !navLink) {
      return;
    }

    // Keep label click behavior predictable: first click opens, second click navigates.
    let labelClickArmed = false;

    const setOpen = (open) => {
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      menu.classList.toggle('opacity-0', !open);
      menu.classList.toggle('invisible', !open);
      menu.classList.toggle('pointer-events-none', !open);
      menu.classList.toggle('translate-y-2', !open);
      menu.classList.toggle('opacity-100', open);
      menu.classList.toggle('visible', open);
      menu.classList.toggle('pointer-events-auto', open);
      menu.classList.toggle('translate-y-0', open);
      if (!open) {
        labelClickArmed = false;
      }
    };

    const closeAndFocusTrigger = () => {
      setOpen(false);
      trigger.focus();
    };

    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      setOpen(!isOpen);
    });

    navLink.addEventListener('click', (event) => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      if (!labelClickArmed) {
        event.preventDefault();
        setOpen(true);
        labelClickArmed = true;
        return;
      }

      // Allow navigation on second click, then reset the arm state.
      labelClickArmed = false;
    });

    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        setOpen(true);
        const firstItem = menu.querySelector('a[role="menuitem"]');
        if (firstItem) {
          firstItem.focus();
        }
      }

      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false);
      }
    });

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeAndFocusTrigger();
      }
    });

    if (supportsFinePointer) {
      dropdown.addEventListener('mouseenter', () => setOpen(true));
      dropdown.addEventListener('mouseleave', () => setOpen(false));
    }

    document.addEventListener('click', (event) => {
      if (!dropdown.contains(event.target)) {
        setOpen(false);
      }
    });

    dropdown.addEventListener('focusout', (event) => {
      if (!dropdown.contains(event.relatedTarget)) {
        setOpen(false);
      }
    });
  });
</script>
