---
interface Props {
  tier: string;
}

const { tier } = Astro.props;

const normalized = (tier || "mixed").toLowerCase();

const tierStyles: Record<string, string> = {
  "entry-level": "bg-apsu-red/15 text-apsu-red border-apsu-red/40",
  standard: "bg-bs-surface-3 text-white border-bs-surface-3",
  advanced: "bg-black text-white border-white/20",
  mixed: "bg-bs-surface-2 text-bs-foreground-light border-bs-surface-3",
};

const label =
  normalized === "entry-level"
    ? "Entry-Level"
    : normalized === "standard"
      ? "Standard"
      : normalized === "advanced"
        ? "Advanced"
        : "Mixed";
---

<span class={`inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold tracking-wide ${tierStyles[normalized] || tierStyles.mixed}`}>
  {label}
</span>
