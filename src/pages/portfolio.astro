---
import Layout from '../layouts/Layout.astro';
import portfolioProjects from '../data/sections/portfolio_projects.json';

const { current, past } = portfolioProjects;
---

<Layout title="Project Portfolio | APSU GIS Center" description="See our work in action. Real-world solutions for real-world problems.">
  <div class="bs-container py-32">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h1 class="bs-h1 mb-6">Our Work</h1>
      <p class="text-xl text-bs-foreground-light">
        Explore how we apply geospatial technology to solve complex problems for our partners.
      </p>
    </div>

    <section class="mb-16">
      <h2 class="bs-h2 mb-8">Current Projects</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {current.map((project) => (
          <article class="bg-bs-surface-2 rounded-xl overflow-hidden border border-bs-surface-3 hover:border-apsu-red/50 transition-colors group">
            <div class="aspect-video bg-bs-surface-3">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            </div>
            <div class="p-8">
              <span class="text-apsu-red text-sm font-bold tracking-wider uppercase mb-2 block">Current Project</span>
              <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-apsu-red transition-colors">{project.title}</h3>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center text-white font-semibold hover:text-apsu-red transition-colors"
              >
                View Project →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2 class="bs-h2 mb-8">Past Projects</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {past.map((project) => (
          <article class="bg-bs-surface-2 rounded-xl overflow-hidden border border-bs-surface-3 hover:border-apsu-red/50 transition-colors group">
            <div class="aspect-video bg-bs-surface-3">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            </div>
            <div class="p-8">
              <span class="text-apsu-red text-sm font-bold tracking-wider uppercase mb-2 block">Past Project</span>
              <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-apsu-red transition-colors">{project.title}</h3>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center text-white font-semibold hover:text-apsu-red transition-colors"
              >
                View Project →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>
