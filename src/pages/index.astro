---
import Layout from '../layouts/Layout.astro';
import Dashboard from '../components/Dashboard.astro';
import ImpactMetrics from '../components/ImpactMetrics.astro';
import { Image } from 'astro:assets';
import TestimonialsCarousel from '../components/TestimonialsCarousel.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import DonationButton from '../components/DonationButton.astro';
import portfolioProjects from '../data/sections/portfolio_projects.json';
import newsImpactStories from '../data/sections/news_impact_stories.json';

import imgCampus from '../assets/images/campus-aerial.jpg';

const portfolioPreview = [
  portfolioProjects.current[0],
  portfolioProjects.past[0],
  portfolioProjects.current[1],
  portfolioProjects.past[1]
];

const storiesSortedByDate = [...newsImpactStories].sort((a, b) => {
  const dateA = a.date || '';
  const dateB = b.date || '';
  return dateB.localeCompare(dateA);
});

const newsPreview = [
  storiesSortedByDate[0],
  storiesSortedByDate[storiesSortedByDate.length - 1],
  storiesSortedByDate[1]
].filter(Boolean);
---

<Layout title="APSU GIS Center | Grant-Ready GIS for Tennessee & Southern Kentucky" description="University-powered GIS services helping local governments and public safety teams in Tennessee and Southern Kentucky win grants, improve readiness, and accelerate economic development.">
  
  <!-- Hero Section -->
  <!-- Hero Section -->
  <section id="hero" class="relative text-center min-h-[85svh] flex flex-col justify-center items-center px-4 overflow-hidden">
    <!-- Background Image -->
    <Image 
      src={imgCampus} 
      alt="Austin Peay State University Campus Aerial View" 
      class="absolute inset-0 w-full h-full object-cover -z-10" 
      quality="high"
    />
    <div class="absolute inset-0 bg-black/60 -z-10"></div>

    <div class="relative z-10 max-w-4xl mx-auto space-y-8 animate-fade-in-up">
      <h1 class="font-header text-6xl md:text-7xl/tight lg:text-8xl/tight font-bold tracking-tight text-white drop-shadow-2xl">
        Grant-Ready GIS for <span class="text-transparent bg-clip-text bg-gradient-to-r from-apsu-red to-red-400">Regional Impact.</span>
      </h1>
      <p class="font-body text-xl md:text-2xl text-gray-100 max-w-2xl mx-auto leading-relaxed drop-shadow-md">
        The APSU GIS Center helps city and county leaders, emergency management teams, and economic development organizations across Tennessee and Southern Kentucky move from data to funded action.
      </p>
      
      <div class="flex flex-wrap gap-4 justify-center pt-4">
        <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + "/services"} class="bs-btn text-lg bg-apsu-red hover:bg-red-700 text-white border-none shadow-[0_0_20px_rgba(196,30,58,0.4)]">
          Explore Service Packages
        </a>
        <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + "/contact"} class="bs-btn bs-btn-outline text-lg border-white text-white hover:bg-white hover:text-black">
          Request a Funding Strategy Call
        </a>
      </div>
    </div>
  </section>

  <!-- Community Snapshot (Dashboard) -->
  <Dashboard />

  <!-- Featured Capabilities Gallery (New Content) -->
  <section class="bs-container py-24 bg-bs-surface-1">
    <div class="text-center mb-16">
      <h2 class="bs-h2 mb-4">Project Portfolio</h2>
      <p class="bs-body-text max-w-2xl mx-auto">See how APSU teams deliver decision-ready mapping, analytics, and digital workflows for public-sector partners.</p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      {portfolioPreview.map((project) => (
        <a href={project.url} target="_blank" rel="noopener noreferrer" class="group relative aspect-[4/5] rounded-xl overflow-hidden cursor-pointer">
          <img src={project.image} alt={project.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          <div class="absolute bottom-0 left-0 p-6 translate-y-2 group-hover:translate-y-0 transition-transform">
            <h3 class="text-xl font-bold text-white mb-1">{project.title}</h3>
            <p class="text-sm text-gray-300 opacity-0 group-hover:opacity-100 transition-opacity delay-100">View live project details</p>
          </div>
        </a>
      ))}
    </div>
    <div class="text-center">
      <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + "/portfolio"} class="bs-btn bs-btn-outline border-apsu-red text-apsu-red hover:bg-apsu-red hover:text-white">
        View Full Portfolio
      </a>
    </div>
  </section>

  <!-- In the News Preview -->
  <section class="bs-container py-24">
    <div class="text-center mb-12">
      <h2 class="bs-h2 mb-4">In the News</h2>
      <p class="bs-body-text max-w-2xl mx-auto">Recent media coverage highlighting APSU GIS Center work across public safety, infrastructure, and innovation.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mb-10">
      {newsPreview.map((story) => (
        <article class="bg-bs-surface-2 rounded-xl overflow-hidden border border-bs-surface-3 hover:border-apsu-red/50 transition-colors group">
          <div class="aspect-[3/2] bg-bs-surface-3">
            <img
              src={story.image}
              alt={story.title}
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
            />
          </div>
          <div class="p-6">
            <p class="text-xs uppercase tracking-wider text-apsu-red font-semibold mb-2">{story.source}</p>
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-apsu-red transition-colors">{story.title}</h3>
            <a href={story.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-white font-semibold hover:text-apsu-red transition-colors">
              Read Story →
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="text-center">
      <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + "/news-impact"} class="bs-btn bs-btn-outline border-apsu-red text-apsu-red hover:bg-apsu-red hover:text-white">
        View All News & Impact
      </a>
    </div>
  </section>

  <!-- Impact Metrics -->
  <ImpactMetrics />

  <!-- Team Quick Link -->
  <section class="bs-container py-16">
    <div class="bg-bs-surface-2 border border-white/10 rounded-2xl p-8 md:p-10 text-center">
      <h2 class="bs-h3 mb-3">Meet the APSU GIS Center Team</h2>
      <p class="bs-body-text max-w-2xl mx-auto mb-6">
        Learn more about the staff and leadership serving communities across Tennessee and Kentucky.
      </p>
      <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + "/about"} class="bs-btn bs-btn-outline border-apsu-red text-apsu-red hover:bg-apsu-red hover:text-white">
        View Team Profiles
      </a>
    </div>
  </section>

  <!-- Services Grid -->
  <section id="services" class="bs-container py-24">
    <div class="text-center mb-16">
      <h2 class="bs-h2 mb-4">Core Services</h2>
      <p class="bs-body-text max-w-2xl mx-auto">Built around high-demand regional needs: emergency readiness, infrastructure resilience, and economic competitiveness.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <!-- Public Safety -->
      <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + "/services/public-safety"} class="group bg-bs-surface-2 p-8 rounded-2xl hover:bg-bs-surface-3 transition-all duration-300 border border-transparent hover:border-apsu-red/20">
        <div aria-hidden="true" class="w-16 h-16 bg-apsu-red/10 rounded-xl flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform text-apsu-red">
          🚒
        </div>
        <h3 class="text-2xl font-bold mb-3 text-white group-hover:text-apsu-red transition-colors">Public Safety</h3>
        <p class="text-bs-foreground-light">Advanced mapping for emergency response, NG911, and hazard mitigation.</p>
      </a>

      <!-- Econ Dev -->
      <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + "/services/economic-development"} class="group bg-bs-surface-2 p-8 rounded-2xl hover:bg-bs-surface-3 transition-all duration-300 border border-transparent hover:border-apsu-red/20">
        <div aria-hidden="true" class="w-16 h-16 bg-apsu-red/10 rounded-xl flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform text-apsu-red">
          📈
        </div>
        <h3 class="text-2xl font-bold mb-3 text-white group-hover:text-apsu-red transition-colors">Economic Dev</h3>
        <p class="text-bs-foreground-light">Data-driven insights for regional growth, site selection, and workforce analysis.</p>
      </a>

      <!-- Campus Map -->
      <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + "/services/campus-mapping"} class="group bg-bs-surface-2 p-8 rounded-2xl hover:bg-bs-surface-3 transition-all duration-300 border border-transparent hover:border-apsu-red/20">
        <div aria-hidden="true" class="w-16 h-16 bg-apsu-red/10 rounded-xl flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform text-apsu-red">
          🎓
        </div>
        <h3 class="text-2xl font-bold mb-3 text-white group-hover:text-apsu-red transition-colors">Campus Mapping</h3>
        <p class="text-bs-foreground-light">Detailed facility management, utility mapping, and student navigation tools.</p>
      </a>
    </div>
  </section>

  <section class="bs-container pb-24">
    <div class="text-center mb-12">
      <h2 class="bs-h2 mb-4">Regional Opportunity Priorities</h2>
      <p class="bs-body-text max-w-3xl mx-auto">Tennessee and Kentucky geospatial ecosystems are expanding shared data infrastructure and cross-agency collaboration. We translate that momentum into executable projects and funding-ready deliverables.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      <article class="bg-bs-surface-2 border border-bs-surface-3 rounded-xl p-6">
        <h3 class="text-2xl font-bold text-white mb-3">Public Safety Readiness</h3>
        <p class="text-bs-foreground-light">Incident mapping, rapid assessment, and resilient operations planning for emergency management and first-response partners.</p>
      </article>
      <article class="bg-bs-surface-2 border border-bs-surface-3 rounded-xl p-6">
        <h3 class="text-2xl font-bold text-white mb-3">Infrastructure & Asset Intelligence</h3>
        <p class="text-bs-foreground-light">Utility, transportation, and facilities mapping aligned with authoritative state and local data-clearinghouse resources.</p>
      </article>
      <article class="bg-bs-surface-2 border border-bs-surface-3 rounded-xl p-6">
        <h3 class="text-2xl font-bold text-white mb-3">Economic Development Competitiveness</h3>
        <p class="text-bs-foreground-light">Site-selection analytics, workforce indicators, and dashboard storytelling designed for grants, investors, and recruitment teams.</p>
      </article>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-32 bg-apsu-red text-white text-center relative overflow-hidden">

    <div class="bs-container relative z-10">
      <h2 class="text-4xl md:text-5xl font-bold mb-8 tracking-tight">Need a grant-ready GIS roadmap this quarter?</h2>
      <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + "/contact"} class="inline-flex items-center gap-2 bg-white text-apsu-red px-8 py-4 rounded-full font-bold text-lg hover:bg-gray-100 transition-transform hover:scale-105 shadow-xl">
        Start a Strategic Consultation
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </section>

<!-- Revenue focused components -->
<TestimonialsCarousel />
<NewsletterSignup />
<DonationButton />
</Layout>
