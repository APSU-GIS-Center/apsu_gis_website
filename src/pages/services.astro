---
import Layout from '../layouts/Layout.astro';
import ServicesBuffet from '../components/ServicesBuffet.astro';
import ServicesComparisonMatrix from '../components/ServicesComparisonMatrix.astro';
import ServicesProofPoints from '../components/ServicesProofPoints.astro';
import ServiceInquiryCard from '../components/ServiceInquiryCard.astro';
import servicesData from '../data/sections/services.json';
import proofPoints from '../data/sections/services_proof_points.json';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const orderedCategories = [...servicesData.categories].sort((a, b) => a.display_order - b.display_order);
const activeServices = servicesData.services.filter((service) => service.active !== false);
const unavailableServices = activeServices.filter((service) => !service.cta_link && !service.fallback_link);
---

<Layout
  title="Services | APSU GIS Center"
  description="Compare affordable GIS service packages by outcomes, audience fit, and delivery tier."
>
  <div class="bs-container py-24 space-y-20">
    <section class="max-w-4xl">
      <p class="text-xs uppercase tracking-[0.2em] text-bs-foreground-dark mb-3">Services Buffet</p>
      <h1 class="bs-h1 mb-6">{servicesData.hero.title}</h1>
      <p class="text-lg text-bs-foreground-light" set:html={servicesData.hero.content} />
    </section>

    <section aria-labelledby="services-proof-points">
      <h2 id="services-proof-points" class="bs-h2 mb-6">By the Numbers</h2>
      <ServicesProofPoints points={proofPoints} />
    </section>

    <section aria-labelledby="services-catalog">
      <h2 id="services-catalog" class="bs-h2 mb-6">Compare Services by Outcome and Tier</h2>
      <p class="text-bs-foreground-light mb-8 max-w-3xl">
        Start with the service that best matches your current pressure points, then expand to a fuller implementation mix as budget allows.
      </p>
      <ServicesBuffet services={activeServices} />
    </section>

    <section aria-labelledby="services-categories" class="space-y-8">
      <h2 id="services-categories" class="bs-h2">Service Tracks</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {orderedCategories.map((category) => (
          <article id={category.id} class="bg-bs-surface-2 border border-bs-surface-3 rounded-xl p-6 scroll-mt-32">
            <h3 class="text-2xl font-bold text-white mb-3">{category.title}</h3>
            <p class="text-bs-foreground-light">{category.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="comparison-matrix" class="space-y-6">
      <h2 id="comparison-matrix" class="bs-h2">Affordability Comparison Matrix</h2>
      <ServicesComparisonMatrix rows={servicesData.comparison} />
    </section>

    <section aria-labelledby="service-inquiry" class="space-y-6">
      <div>
        <h2 id="service-inquiry" class="bs-h2 mb-3">{servicesData.inquiry_intro.title}</h2>
        <p class="text-bs-foreground-light max-w-3xl">{servicesData.inquiry_intro.content}</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {activeServices.map((service) => (
          <ServiceInquiryCard
            title={service.title}
            ctaText={service.cta_text}
            ctaLink={service.cta_link || (baseUrl + '/contact')}
            fallbackText={service.fallback_text}
            fallbackLink={service.fallback_link || (baseUrl + '/contact')}
          />
        ))}
      </div>
    </section>

    {unavailableServices.length > 0 && (
      <section aria-live="polite" class="bg-bs-surface-2 border border-apsu-red/40 rounded-xl p-6">
        <h2 class="text-xl font-bold text-white mb-2">Temporary Service Route Notice</h2>
        <p class="text-bs-foreground-light mb-3">
          Some service-specific routes are temporarily unavailable. Continue through our primary consultation path while we restore direct links.
        </p>
        <a href={baseUrl + '/contact'} class="bs-btn bg-apsu-red hover:bg-red-700 text-white border-none">
          Continue to Consultation
        </a>
      </section>
    )}
  </div>
</Layout>
